
# --- Aplicação & Ambiente ---
ENVIRONMENT=development
# Em production, o startup valida Snowflake, MLflow Tracking e o provider dos modelos.
LOG_LEVEL=info

# --- Autenticação & Segurança (LGPD / JWT) ---
# Produção: injete no ambiente do processo; arquivos .env locais não são carregados.
# Chave aleatória persistente, mínimo 32 caracteres e diversidade adequada.
# Vazio somente em desenvolvimento: gera uma chave efêmera por processo.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
# O proxy futuro deve permitir o multipart completo (arquivo + overhead).
# A aplicação continua impondo MAX_UPLOAD_BYTES ao conteúdo do arquivo.
# DEMO: configure apenas em development/test; proibido em production.
DEMO_EMAIL=
DEMO_PASSWORD=
ADMIN_EMAIL=
# Produção: mínimo 16 caracteres, diversidade adequada, sem valores de exemplo.
ADMIN_PASSWORD=

# --- Provedores de IA / LLM (Modo Free vs Produção) ---
LLM_PROVIDER=disabled
LLM_FALLBACK_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=12

# Limites da aplicação, não limites oficiais da OpenAI.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Barreira compartilhada por IP, maior para permitir usuários atrás de NAT.
AI_RATE_LIMIT_IP_REQUESTS=100
# Retries adicionais: 0 a 2, além da tentativa inicial. SDK sem retries internos.
AI_OPENAI_MAX_RETRIES=2
# Obrigatório com limitador ativo em produção. Use rediss:// para TLS.
# Sem URL, somente development/test usa memória (um processo).
REDIS_URL=

# --- Observabilidade & MLOps ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=crm-alto-valor-azul
# Opcional no desenvolvimento; configure somente para habilitar MLflow.
MLFLOW_TRACKING_URI=
# Nome exato do modelo fornecido pelo ambiente/Registry, sem renomear o externo.
MLFLOW_MODEL_NAME=

# --- Persistência do Data Lake Medalhão & Vetores ---
DUCKDB_PATH=../data/processed/azul_datalake.duckdb
VECTORDB_PATH=../data/vectordb
# --- Data Lake (Snowflake para o ambiente integrado; DuckDB para local/offline) ---
DATA_LAKE_BACKEND=duckdb
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AZUL_DATA_LAKE
SNOWFLAKE_ROLE=
# Banco isolado exclusivo, usado somente pelo teste real Snowflake.
SNOWFLAKE_TEST_DATABASE=CRM_TEST_E2E
# E2E real sempre opt-in; infraestrutura isolada e autorização são pré-condições.
SNOWFLAKE_INTEGRATION_TESTS=0
MLFLOW_INTEGRATION_TESTS=0

# --- MLflow Serving legado (separado do Tracking; não usado pelos modelos integrados) ---
MLFLOW_SERVING_URL=
# Compatibilidade do fluxo legado.
MLFLOW_LOCAL_INFERENCE=false

# --- Modelos reais de Churn e CLV ---
# Os caminhos locais são relativos à raiz do repositório por padrão.
ML_INFERENCE_MODE=local
ML_CHURN_MODEL_PATH=modelo_churn
ML_CLV_MODEL_PATH=pacote_CLV/modelo_clv
ML_INFERENCE_TIMEOUT_SECONDS=15
# Ordem verificada em modelo_churn: classes_=[0, 1]; positivo = high_risk_flag 1.
ML_CHURN_CLASS_ORDER=0,1

# Databricks Model Serving (necessário somente com ML_INFERENCE_MODE=databricks).
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CHURN_ENDPOINT=
DATABRICKS_CLV_ENDPOINT=
