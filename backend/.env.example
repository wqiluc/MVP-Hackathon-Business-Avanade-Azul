
# --- Aplicação & Ambiente ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Autenticação & Segurança (LGPD / JWT) ---
# Gerados via 'openssl rand -hex 32' ou secrets do Python
# python -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32)); print('JWT_SECRET_KEY=' + secrets.token_hex(32))"

SECRET_KEY=sua_secret_key_hex_32_caracteres_aqui
JWT_SECRET_KEY=sua_jwt_secret_key_hex_32_caracteres_aqui
ACCESS_TOKEN_EXPIRE_HOURS=8

# --- Provedores de IA / LLM (Modo Free vs Produção) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=sua_chave_openai_opcional_aqui

# --- Observabilidade & MLOps ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=sua_chave_langsmith_opcional_aqui
LANGCHAIN_PROJECT=azul-crm-aeroshield
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Persistência do Data Lake Medalhão & Vetores ---
DUCKDB_PATH=../data/processed/azul_datalake.duckdb
VECTORDB_PATH=../data/vectordb
# --- Data Lake (Snowflake para o ambiente integrado; DuckDB para local/offline) ---
DATA_LAKE_BACKEND=duckdb
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AZUL_DATA_LAKE
SNOWFLAKE_ROLE=
# Banco isolado, com prefixo AEROSHIELD_TEST_, usado somente pelo teste real Snowflake.
SNOWFLAKE_TEST_DATABASE=

# --- Inferência MLflow Serving (ex.: http://localhost:5000/invocations) ---
MLFLOW_SERVING_URL=
