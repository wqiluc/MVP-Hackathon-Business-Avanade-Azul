
# --- Aplicação & Ambiente ---
ENVIRONMENT=development
# Em production, o startup falha se Snowflake/MLflow remotos não estiverem configurados
# (DATA_LAKE_BACKEND=snowflake, credenciais Snowflake completas, MLFLOW_TRACKING_URI remoto,
# MLFLOW_SERVING_URL preenchida, MLFLOW_LOCAL_INFERENCE=false).
LOG_LEVEL=info

# --- Autenticação & Segurança (LGPD / JWT) ---
# Substitua os valores de exemplo; em produção, defina uma chave aleatória persistente.
JWT_SECRET_KEY=replace-with-a-random-secret
ACCESS_TOKEN_EXPIRE_HOURS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
DEMO_EMAIL=analista@example.invalid
DEMO_PASSWORD=replace-before-use
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-before-use

# --- Provedores de IA / LLM (Modo Free vs Produção) ---
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12

# Limites da aplicação, não limites oficiais da OpenAI.
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
# Barreira compartilhada por IP, maior para permitir usuários atrás de NAT.
AI_RATE_LIMIT_IP_REQUESTS=100
# Retries adicionais: 0 a 2, além da tentativa inicial. SDK sem retries internos.
AI_OPENAI_MAX_RETRIES=2
# Obrigatório com limitador ativo em produção. Use rediss:// para TLS.
# Sem URL, somente development/test usa memória (um processo).
REDIS_URL=

# --- Observabilidade & MLOps ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=sua_chave_langsmith_opcional_aqui
LANGCHAIN_PROJECT=crm-alto-valor-azul
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Persistência do Data Lake Medalhão & Vetores ---
DUCKDB_PATH=../data/processed/azul_datalake.duckdb
VECTORDB_PATH=../data/vectordb
# --- Data Lake (Snowflake para o ambiente integrado; DuckDB para local/offline) ---
DATA_LAKE_BACKEND=duckdb
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=AZUL_DATA_LAKE
SNOWFLAKE_ROLE=
# Banco isolado, com prefixo AEROSHIELD_TEST_, usado somente pelo teste real Snowflake.
SNOWFLAKE_TEST_DATABASE=

# --- MLflow Serving (separado do Tracking; configure após registrar o modelo) ---
MLFLOW_SERVING_URL=
# Habilite somente para desenvolvimento/testes locais sem Serving.
MLFLOW_LOCAL_INFERENCE=false
